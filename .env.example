# ─────────────────────────────────────────────────────────────────────────────
#  HSC / SSC Exam Form Portal — settings
#  Copy this file to ".env" and fill in the values. Never upload .env publicly.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="HSC/SSC Exam Portal"
# local = your computer (XAMPP), production = live website (Hostinger)
APP_ENV=production
# Leave empty, then run:  php artisan key:generate   (or use the key from INSTALL.md)
APP_KEY=
# true only while testing on your computer. Always false on the live website.
APP_DEBUG=false
# Full address of the site, no trailing slash.
#   XAMPP:     http://localhost/HSC-exam
#   Hostinger: https://hscexam.in
APP_URL=http://localhost/HSC-exam
APP_TIMEZONE=Asia/Kolkata

# Default language of the website: mr (Marathi), en (English) or hi (Hindi)
APP_LOCALE=mr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# ── Database ─────────────────────────────────────────────────────────────────
#   XAMPP:     DB_USERNAME=root, DB_PASSWORD= (empty)
#   Hostinger: the database, user and password created in hPanel → Databases
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hsc_exam
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true on the live https website
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# Set true only if "php artisan storage:link" is not possible on your host.
UPLOADS_IN_PUBLIC=false
BROADCAST_CONNECTION=log

# ── Private staff sign-in addresses ──────────────────────────────────────────
# These pages are never linked from the website. Change them to your own secret
# words before going live and share each address only with that group.
#   e.g. https://hscexam.in/control-room-7k2
ADMIN_LOGIN_PATH=control-room-7k2
BOARD_LOGIN_PATH=board-desk-4m9
INSTITUTE_LOGIN_PATH=college-desk-8p3
TEACHER_LOGIN_PATH=teacher-desk-5q1

# ── Google sign-in for students ──────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI must be exactly APP_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ── Exam fee payments (Cashfree Payments) ────────────────────────────────────
# merchant.cashfree.com → Developers → API keys. Use sandbox keys while testing.
# Webhook URL to add in Cashfree: APP_URL + /payments/cashfree/webhook
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox or production
CASHFREE_ENV=sandbox

# ── Testing helpers (keep false on the live website) ─────────────────────────
# Shows a "Simulate payment" button when Cashfree keys are empty.
ALLOW_TEST_PAYMENTS=false
# Shows a "demo student" sign-in button on the login page.
ALLOW_DEMO_STUDENT_LOGIN=false

# Password for the first "superadmin" login when the database is set up with
# "php artisan migrate --seed". Leave empty to get a random one printed once.
SEED_ADMIN_PASSWORD=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@hscexam.in"
MAIL_FROM_NAME="${APP_NAME}"
